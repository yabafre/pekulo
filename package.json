{
  "name": "test",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -c -e .env -e .env.local -- turbo run dev",
    "dev:web": "dotenv -c -e .env -e .env.local -- turbo run dev --filter='@pekulo/web'",
    "dev:prices": "dotenv -c -e .env -e .env.local -- bash -lc 'cd apps/prices && uvicorn main:app --reload --port 8000'",
    "build": "dotenv -c -e .env -e .env.local -- turbo run build",
    "start": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/web' run start",
    "start:web": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/web' run start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "turbo run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install",
    "generate:tamagui-css": "bun --filter='@pekulo/ui' run generate:tamagui-css && bunx oxfmt packages/ui/public/tamagui.generated.css",
    "prisma:generate": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:generate",
    "prisma:migrate:dev": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:migrate:dev",
    "prisma:migrate:deploy": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:migrate:deploy",
    "prisma:migrate:status": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:migrate:status",
    "prisma:studio": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:studio",
    "prisma:format": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:format",
    "prisma:validate": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:validate",
    "prisma:check": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run prisma:check",
    "db:rls-audit": "dotenv -c -e .env -e .env.local -- bun --filter='@pekulo/api' run db:rls-audit",
    "test:ui": "bun --filter='@pekulo/ui' run test",
    "test:ui:axe": "bun --filter='@pekulo/ui' run test:axe",
    "test:ui:visual": "bun --filter='@pekulo/ui' run test:visual"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "lefthook": "2.1.6",
    "oxfmt": "0.47.0",
    "oxlint": "1.62.0",
    "turbo": "^2.9.6"
  },
  "packageManager": "bun@1.3.13"
}

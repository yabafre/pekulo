# ============================================================
# Plan Financier — root .env
# Loaded by every monorepo script via `dotenv -e .env --` prefix.
# Both apps/web (Next.js) and apps/prices (Python) read from here.
# Copy to `.env.local` and fill the values. `.env.local` is gitignored.
# ============================================================

# ---------- Supabase (apps/web) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------- Prices service shared (apps/web client + apps/prices server) ----------

# Primary price provider — Python yfinance microservice (deploy via Dokploy).
# Leave empty to skip and fall back to yahoo-finance2 npm package directly.
PRICES_SERVICE_URL=
# Generate a strong random string: `openssl rand -hex 32`
# Set the same value here AND on the Python service (apps/prices needs it for auth).
PRICES_SERVICE_TOKEN=

# ---------- apps/prices only (FastAPI service) ----------

# CORS origin allowlist for the prices service (apps/prices/main.py reads
# PRICES_CORS_ORIGINS). Comma-separated list of exact origins. NEVER ship "*" —
# set the exact apps/web origin (e.g. https://app.pekulo.example). Default is
# empty (no browser origin allowed) — the service is a server-to-server backend.
# NOTE: ALLOWED_ORIGIN below is the legacy name and is no longer read by the
# service; PRICES_CORS_ORIGINS is the live variable.
PRICES_CORS_ORIGINS=
ALLOWED_ORIGIN=https://app.pekulo.example

# Browser TLS fingerprint passed to curl_cffi for yfinance (apps/prices). The
# service builds an explicit Session(impersonate=<value>). Default "chrome".
YF_IMPERSONATE=chrome

# ---------- apps/web only (optional Twelve Data fallback) ----------

# Free key at https://twelvedata.com (no credit card, 800 req/day).
# Free tier covers US only — European ETFs need the paid Grow plan.
TWELVE_DATA_API_KEY=

# ---------- apps/api FX provider (story 3-3, FR-18) ----------
# Frankfurter API base URL for currency conversion. Optional — when unset the
# portfolio snapshot computes with a 1:1 identity rate (fxSource: 'fallback').
FRANKFURTER_BASE_URL=

# ---------- apps/api (Prisma direct connection) ----------
# Local dev: spin up the Supabase Docker stack from apps/web — it ships a Postgres
# on port 54322 with the `auth` schema (auth.users + auth.uid()) populated.
#
#   (cd apps/web && bunx supabase start)
#
# Then copy this line into the root `.env.local` (gitignored). Pekulo's monorepo
# convention is root-only env files — apps/api/prisma.config.ts resolves the
# repo root from its own location and loads it. Production uses the Supabase
# project's connection string set in Dokploy env, never committed here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Migration datasource for Prisma (apps/api/prisma.config.ts). When set it is
# used for `prisma migrate` instead of DATABASE_URL — point it at a direct /
# session-pooler connection (port 5432) when DATABASE_URL is a transaction
# pooler (Supabase pgbouncer on 6543, which cannot run migrations). Optional;
# falls back to DATABASE_URL when unset.
DIRECT_URL=

# ---------- apps/api runtime (src/config/env.ts) ----------
# HTTP listener. Defaults match the Zod schema: HOST=127.0.0.1, PORT=3001.
HOST=127.0.0.1
PORT=3001
# Graceful-shutdown budget in ms (app.stop → OTel flush → Prisma disconnect).
# Default 10000, max 60000.
SHUTDOWN_TIMEOUT_MS=10000

# ---------- apps/web → apps/api oRPC link (server-only) ----------
# apps/api base URL — consumed by apps/web's oRPC link (server-side only, never NEXT_PUBLIC_*).
# Local dev default matches apps/api's PORT=3001 from src/config/env.ts.
API_BASE_URL=http://127.0.0.1:3001

# ---------- apps/api JWT verification (story 0-6) ----------
# Symmetric (HS256) Supabase JWT secret — apps/api verifies every Bearer token
# forwarded from apps/web's oRPC client. Read it from `bunx supabase status`
# (line "JWT secret"). Production uses the Supabase project's JWT secret set
# in Dokploy env, never committed here. MUST be ≥ 32 chars.
SUPABASE_JWT_SECRET=

# Supabase project URL — used by apps/api to derive the JWT issuer claim
# `<SUPABASE_URL>/auth/v1` for `iss` verification (ADR-0013 belt+suspenders).
# Same value as NEXT_PUBLIC_SUPABASE_URL above; declared independently so
# apps/api can boot without depending on a `NEXT_PUBLIC_*` var name.
SUPABASE_URL=https://your-project.supabase.co

# ---------- Bridge bank-aggregator (story 5-6, ADR-0015) ----------
# Bridge developer credentials. Sign up at https://dashboard.bridgeapi.io.
# CLIENT_ID is public-ish (visible in dev console headers); CLIENT_SECRET
# MUST live ONLY on the apps/api Dokploy env — never apps/web, never git.
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=
# HMAC-SHA256 signing secret for the /internal/bridge/webhook receiver
# (NFR-33). Bridge rotates this — keep the previous value populated during
# the 24h overlap window so in-flight webhooks signed with the old secret
# still verify (max 2 active per the Bridge docs).
BRIDGE_WEBHOOK_SIGNING_SECRET=
BRIDGE_WEBHOOK_SIGNING_SECRET_PREVIOUS=
# Bridge API base + version pin. Defaults match the apps/api Zod schema:
# https://api.bridgeapi.io + 2025-01-15. Override only if pointing at the
# Bridge staging environment.
BRIDGE_API_BASE=https://api.bridgeapi.io
BRIDGE_API_VERSION=2025-01-15
# Backup-refresh cadence — Bridge's own scheduler webhooks (item.refreshed
# with status_code=0) are the primary fresh signal; this cron is the safety
# net. Default 6h; set to 24 for personal-use V1 if Bridge scheduler is
# reliable enough.
BRIDGE_REFRESH_CRON_HOURS=6
# Backfill (épic 6) — hourly LLM-categorisation sweep cadence (h). Optional,
# default 1. The safety net behind the post-sync backfill: it (re)categorises
# imported 'autre' transactions the bulk import left uncategorised, retries rows
# whose suggestion failed (LLM was down), and catches pre-feature imports.
SUGGESTION_BACKFILL_CRON_HOURS=1
# Webhook dev URL — Bridge needs a public HTTPS endpoint to deliver events.
# Local dev pattern: `cloudflared tunnel --url http://localhost:3001` then
# configure the tunnel URL on https://dashboard.bridgeapi.io webhook settings.

# ---------- apps/api LLM providers (Epic 6 — FR-31 ; provider config 6-4) ----------
# Default categorisation runs on self-hosted Ollama (localhost on the Dokploy
# VPS, never publicly exposed). Every var is optional — unset = safe defaults.
#
# Ollama: default model qwen2.5:3b (instruction-tuned, strong FR + JSON, CPU-fast
# enough for NFR-5: p95 ≤ 1.5 s / 5 s hard cap). On a GPU host, set
# OLLAMA_MODEL=qwen2.5:7b for better quality (a 7B on CPU blows the 5 s cap).
OLLAMA_BASE_URL=
OLLAMA_MODEL=
#
# Third-party route (opt-in only, FR-34). OpenAI-COMPATIBLE transport. Default =
# Mistral La Plateforme (EU-hosted → no extra-EU transfer, RGPD-friendly). The
# KEY lives ONLY in the Dokploy env — never apps/web, never git.
#   PROD (EU/RGPD):  leave BASE_URL empty → Mistral https://api.mistral.ai/v1/chat/completions
#                    THIRD_PARTY_LLM_MODEL=mistral-small-latest
#   DEV/TEST (compare models via OpenRouter, one key):
#     THIRD_PARTY_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
#     THIRD_PARTY_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
#       (or anthropic/claude-haiku-4.5, google/gemini-2.5-flash-lite, …)
# NOTE: do NOT route real user transactions through OpenRouter (US) in prod —
# keep prod on the direct EU provider; OpenRouter is a dev/test gateway only.
THIRD_PARTY_LLM_API_KEY=
THIRD_PARTY_LLM_BASE_URL=
THIRD_PARTY_LLM_MODEL=

# ---------- apps/api LLM benchmark script (scripts/llm-bench.ts) ----------
# Dev-only model comparison harness — NOT used by the running service.
# OpenRouter API key (falls back from THIRD_PARTY_LLM_API_KEY if set).
OPENROUTER_API_KEY=
# Comma-separated model slugs to benchmark. Defaults to a built-in OpenRouter
# list; override e.g. BENCH_MODELS="mistralai/mistral-small,anthropic/claude-haiku-4.5".
BENCH_MODELS=

# ---------- apps/api Brandfetch logos (story 6-10 — FR-65) ----------
# Merchant-logo tier of the 3-tier transaction avatar (merchant → bank →
# category icon). SERVER-SIDE ONLY — the key lives in the Dokploy env, never in
# apps/web, never in git. Unset → the merchant tier is a graceful no-op (the
# bank logo + category icon still render). The _BASE defaults match the apps/api
# Zod schema (Brand Search + Logo Link CDN); override only to point elsewhere.
BRANDFETCH_API_KEY=
BRANDFETCH_SEARCH_BASE=https://api.brandfetch.io/v2/search
BRANDFETCH_LOGO_BASE=https://cdn.brandfetch.io
BRANDFETCH_LOGO_CLIENT_ID=

# ---------- OpenTelemetry (shared: apps/api + apps/web + apps/prices) ----------
# OTLP-HTTP traces endpoint (story 0-7 — ADR-0005). When unset, all three tiers
# fall back to a stdout ConsoleSpanExporter (V1 (a) default). The api appends
# the per-signal path (/v1/traces); apps/web treats it as the exact endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name reported on spans. Defaults per tier: pekulo-api / pekulo-web /
# pekulo-prices. Override to disambiguate multiple deploys of the same tier.
OTEL_SERVICE_NAME=
# apps/web only — comma-separated host substrings/regex added to the outbound
# traceparent propagation allowlist. NEVER use ".*" in prod (leaks trace IDs to
# third parties). Defaults to localhost + *.pekulo.* only.
OTEL_PROPAGATE_HOSTS=
# apps/api only — OTel internal diag log level: error|warn|info|debug.
# Default "error". "debug" also flips the api to a synchronous SimpleSpanProcessor.
OTEL_LOG_LEVEL=error

# ---------- apps/web public site origin (story 8-1, FR-48) ----------
# Public site origin (no trailing slash), used to build the password-reset
# email redirect link. e.g. https://app.pekulo.example or
# http://localhost:3002 in dev. When unset, the auth action falls back to the
# forwarded host headers.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

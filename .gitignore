# Dependencies
node_modules
.pnp
.pnp.*

# iCloud eviction guard (per-machine). This repo lives under an iCloud-synced
# ~/Documents; iCloud evicts files it deems cold, and a `dataless` file blocks
# every read on it forever — which silently hangs tsc, oxlint, vitest and bun's
# postinstall at 0 % CPU with no error. iCloud skips any path ending in
# `.nosync`, so node_modules/.next live there with a symlink at the real name.
*.nosync

# Bun
bun.lockb

# Builds
# No trailing slash: `.next` is a symlink to `.next.nosync` here, and a
# directory-only pattern would leave that symlink untracked-but-visible.
.next
.turbo/
.tamagui/
dist/
out/
build/

# Coverage reports (regenerated by `bun run test:coverage`)
coverage/

# Tamagui CLI artefacts (regenerated on dev/build)
apps/web/tamagui-prompt.md

# Env (local secrets — never commit)
# Deny-by-default: `.env.bak-t16`, a hand-made backup carrying the service-role
# key and the DB password, sat here untracked and UNIGNORED through story 9-2 —
# one `git add .` from the history. `.env*` catches every future variant; the
# negations below are the only files that may ever be committed.
.env*
!.env.example
!.env*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors / OS
.DS_Store
.idea/
.vscode/

# Python (apps/prices)
__pycache__/
*.py[cod]
.venv/
venv/

# TypeScript
*.tsbuildinfo

# AI agents / IDE workflows (local-only configs — not part of the product)
.mcp.json
.codex/
.opencode/
.windsurf/

# APED engine local runtime artefacts (per-machine, not committed)
.aped/.last-test-exit

# Claude Code per-machine runtime state (session lockfiles, etc.)
.claude/scheduled_tasks.lock

# Supabase CLI local-state directory (per-machine branch metadata, not committed)
apps/web/supabase/.branches/
.vercel

# CLAUDE.md context files (keep only root CLAUDE.md)
**/CLAUDE.md
!/CLAUDE.md

# Yarn 4 — Vercel install only; bun is local DX. Keep .yarn/releases (binary)
# and .yarnrc.yml committed; ignore everything else yarn generates.
.yarn/*
!.yarn/releases
.yarn/install-state.gz
yarn.lock

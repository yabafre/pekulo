{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@pekulo/tsconfig/apps.json",
  "compilerOptions": {
    "lib": ["dom", "esnext"],
    "jsx": "react-jsx",
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "moduleSuffixes": [".native", ".ios", ".android", ""],
    "types": ["jest"],
    "paths": {
      "@/*": ["./*"],
      "react-native": ["./node_modules/react-native/types_DEPRECATED/index.d.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "ios", "android"]
}

{
  "name": "@pekulo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pekulo domain API — Bun + Elysia + oRPC. See ADR-0009.",
  "main": "./src/main.ts",
  "scripts": {
    "dev": "bun --hot src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elysia": "1.4.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@pekulo/tsconfig": "workspace:*",
    "@types/bun": "1.3.0",
    "typescript": "^5.6.0"
  }
}
